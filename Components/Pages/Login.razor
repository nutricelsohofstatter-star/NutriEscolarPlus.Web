@code{private string Email="";private string Senha="";private string Erro="";private void Entrar(){var senhaDemo=Configuration["DEMO_PASSWORD"];if(Email.Equals("nutricelsohofstatter@gmail.com",StringComparison.OrdinalIgnoreCase)&&!string.IsNullOrEmpty(senhaDemo)&&Senha==senhaDemo)NavigationManager.NavigateTo("/",true);else Erro="E-mail ou senha inválidos.";}}
