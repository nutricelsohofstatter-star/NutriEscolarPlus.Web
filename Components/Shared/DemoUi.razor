@using Microsoft.AspNetCore.Components
<div class="page-title"><span>@Eyebrow</span><h2>@Title</h2><p>@Subtitle</p></div>
<div class="stats"><div><i>👥</i><span>Total</span><b>@Total</b></div><div><i>✓</i><span>Ativos</span><b>@Ativos</b></div><div><i>📅</i><span>Este mês</span><b>@Mes</b></div><div><i>⚠️</i><span>Pendências</span><b>@Pendencias</b></div></div>
<div class="panel"><div class="panel-head"><div><b>@PanelTitle</b><small>Dados demonstrativos para apresentação</small></div><button>+ Novo registro</button></div>
<table><thead><tr><th>Nome / Registro</th><th>Categoria</th><th>Data</th><th>Status</th></tr></thead><tbody>@foreach(var x in Items){<tr><td><b>@x.Nome</b></td><td>@x.Categoria</td><td>@x.Data</td><td><span class="status">@x.Status</span></td></tr>}</tbody></table></div>
@code{
[Parameter] public string Eyebrow{get;set;}="GESTÃO"; [Parameter] public string Title{get;set;}="Módulo"; [Parameter] public string Subtitle{get;set;}="Acompanhe as informações da instituição."; [Parameter] public string PanelTitle{get;set;}="Registros recentes"; [Parameter] public int Total{get;set;}=86; [Parameter] public int Ativos{get;set;}=82; [Parameter] public int Mes{get;set;}=12; [Parameter] public int Pendencias{get;set;}=3;
private readonly (string Nome,string Categoria,string Data,string Status)[] Items={ ("Ana Clara Martins","Educação Infantil","06/10/2026","Atualizado"),("Miguel Oliveira","Maternal II","05/10/2026","Atualizado"),("Helena Souza","Pré II","02/10/2026","Acompanhar"),("Arthur Lima","Maternal I","30/09/2026","Atualizado")};
}
